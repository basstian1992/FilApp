rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Especialistas (perfiles): solo usuarios autenticados ──
    match /especialistas/{docId} {
      allow read, write: if request.auth != null;
    }

    // ── Instituciones: lectura pública (TV/Tótem sin auth), escritura autenticada ──
    match /institutions/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // ── Turnos: lectura pública (TV/Tótem), escritura autenticada ──
    match /turnos/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // ── Usuarios: solo usuarios autenticados ──
    match /usuarios/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
