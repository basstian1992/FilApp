rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Especialistas (perfiles): solo usuarios autenticados ──
    match /especialistas/{docId} {
      allow read, write: if request.auth != null;
    }

    // ── Instituciones: lectura pública (TV/Tótem sin auth), escritura autenticada ──
    match /institutions/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // ── Sedes / Dependencias físicas de una institución: lectura pública (TV/Tótem), escritura autenticada ──
    match /sedes/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // ── Turnos: lectura pública (TV/Tótem), escritura autenticada ──
    match /turnos/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // ── Usuarios: base ESTANDARIZADA por institución (clave = RUT, etiqueta
    //    institution_id; compartida por todas las dependencias). Solo clientes
    //    autenticados (paneles). Las pantallas públicas (TV/Tótem) acceden vía
    //    /api/usuarios con credenciales de administrador del servidor. ──
    match /usuarios/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
